# Contraseña del administrador de SQL Server
DB_PASSWORD=CONTRASENA_SQL_SERVER

# Contraseña del administrador de MongoDB
MONGO_PASSWORD=CONTRASENA_MONGODB

# Dirección de conexión a MongoDB
MONGODB_URI=mongodb://admin:CONTRASENA_MONGODB@mongodb:27017/order_db?authSource=admin

# Clave secreta para generar y validar tokens JWT (mínimo 32 bytes)
JWT_SECRET=CLAVE_SECRETA_JWT_DE_AL_MENOS_32_BYTES